local players = game:GetService('Players')
local player = players.LocalPlayer

local window = imgui({
	title = 'player text overlay',
	size = Vector2.new(260, 150),
	position = Vector2.new(60, 120),
})

local enabled = true
local raycast_enabled = true
local max_distance = 500

window:addtoggle({
	text = 'enabled',
	default = true,
	callback = function(state)
		enabled = state
	end,
})

window:addtoggle({
	text = 'raycast check',
	default = true,
	callback = function(state)
		raycast_enabled = state
	end,
})

window:addslider({
	text = 'max distance',
	min = 50,
	max = 2000,
	default = 500,
	callback = function(value)
		max_distance = value
	end,
})

local visible_color = Color3.fromRGB(80, 255, 120)
local blocked_color = Color3.fromRGB(255, 80, 80)
local plain_color = Color3.fromRGB(255, 255, 255)

local function is_visible(origin, target_part, target_character)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(origin, target_part.Position - origin, params)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(target_character)
end

task.spawn(function()
	while true do
		task.wait(0.03)

		if not enabled then
			imgui:drawtexts({})
			continue
		end

		local camera = workspace.CurrentCamera
		local origin = camera.CFrame.Position
		local items = {}

		for _, other in ipairs(players:GetPlayers()) do
			if other ~= player and other.Character then
				local head = other.Character:FindFirstChild('Head')
				local humanoid = other.Character:FindFirstChildOfClass('Humanoid')
				if head and humanoid and humanoid.Health > 0 then
					local distance = (head.Position - origin).Magnitude
					if distance <= max_distance then
						local screen, on_screen = camera:WorldToScreenPoint(head.Position + Vector3.new(0, 1.5, 0))
						if on_screen then
							local color = plain_color
							if raycast_enabled then
								color = is_visible(origin, head, other.Character) and visible_color or blocked_color
							end
							items[#items + 1] = {
								x = screen.X,
								y = screen.Y,
								color = color,
								text = string.format('%s [%d]', other.Name, math.floor(distance)),
							}
						end
					end
				end
			end
		end

		imgui:drawtexts(items)
	end
end)
